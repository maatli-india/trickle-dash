# Base URL of the transitorder Go backend (server-side only — never exposed
# to the browser). No trailing slash.
# Local:  http://localhost:7003/trickle
# Netlify/QA/prod: set this in the host env and redeploy. If unset in
# production the app uses https://api.trickle-dev.maatli.com/trickle.
API_BASE_URL=http://localhost:7003/trickle

# Required on Netlify. Generate once and keep stable across deploys:
#   openssl rand -base64 32
# Without it, Next server-action POSTs (login) can 500 after a new build.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Name of the cookie holding the admin session. Change only if you need to
# run multiple dashboard instances against the same domain.
SESSION_COOKIE_NAME=trickle_dash_session
