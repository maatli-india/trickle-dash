# Base URL of the transitorder Go backend. No trailing slash, no /v1.
# Same key as trickle-web; the support-chat WebSocket uses the same host.
NEXT_PUBLIC_API_BASE_URL=http://localhost:7003/trickle

# Name of the cookie holding the admin session. Change only if you need to
# run multiple dashboard instances against the same domain.
SESSION_COOKIE_NAME=trickle_dash_session
